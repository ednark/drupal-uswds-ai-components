{
  "name": "drupal-uswds-ai-components",
  "description": "Drupal implementation knowledge for USWDS components. Maps each USWDS component to its Drupal module, paragraph type, Twig template, and configuration.",
  "designSystem": {
    "name": "U.S. Web Design System (Drupal)",
    "version": "3.13.0",
    "url": "https://designsystem.digital.gov"
  },
  "agentMetaId": "drupal-uswds-agent-meta",
  "tileDir": "infinite",
  "facets": [
    "implementationType",
    "drupalModule",
    "uswdsComponent",
    "paragraphType",
    "themeRegion",
    "complexity",
    "drupalVersion"
  ],
  "indexSchemaVersion": 1,
  "repo": "https://github.com/ednark/drupal-uswds-ai-components",
  "base": "https://raw.githubusercontent.com/ednark/drupal-uswds-ai-components/main",
  "additionalFields": [
    "useWhen",
    "avoidWhen",
    "agentPrompt",
    "editableAreas",
    "preserveElements",
    "knownLimitations",
    "twigTemplate",
    "preprocessFunction",
    "drushCommands",
    "configYaml",
    "scssSettings",
    "fieldDefinitions",
    "dependencies"
  ],
  "govCompliance": [
    "Section 508",
    "WCAG 2.1 AA",
    "21st Century IDEA"
  ],
  "mcp": {
    "enabled": true,
    "server": "_base/mcp/server.mjs",
    "transport": "stdio",
    "tools": [
      "search_components",
      "get_component",
      "list_facets",
      "get_index"
    ]
  },
  "updated": "2.0.0",
  "metadataSchemaVersion": 2,
  "language": "en",
  "gaps": [
    {
      "concept": "webforms (Form API)",
      "status": "not_part_of_design_system",
      "nearestAlternative": "text-input / form tiles + Drupal Form API guidance",
      "reason": "Drupal forms are built with the Form API, not static markup — the form tile documents the render-array approach"
    },
    {
      "concept": "views-listings",
      "status": "deferred",
      "nearestAlternative": "card / collection tiles",
      "reason": "Views-driven listings are configuration, not markup — candidate for a Views-display tile"
    },
    {
      "concept": "combobox/autocomplete",
      "status": "deferred",
      "nearestAlternative": "select / text-input",
      "reason": "Not among the tiled Drupal implementations"
    },
    {
      "concept": "mega-menu",
      "status": "deferred",
      "nearestAlternative": "side-navigation",
      "reason": "The Big Menu (tbm-*) integration is observed in the mega-menu tile but not fully documented"
    }
  ]
}